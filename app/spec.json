{
    "abi-return-struct-as-int":  true,
    "arch":  "x86_64",
    "binary-format":  "coff",
    "cpu":  "x86-64",
    "crt-objects-fallback":  "mingw",
    "data-layout":  "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
    "dll-prefix":  "",
    "dll-suffix":  ".dll",
    "dll-tls-export":  false,
    "dynamic-linking":  true,
    "eh-frame-header":  false,
    "emit-debug-gdb-scripts":  false,
    "env":  "gnu",
    "exe-suffix":  ".exe",
    "features":  "+cmpxchg16b,+sse3,+lahfsahf",
    "function-sections":  false,
    "has-thread-local":  true,
    "is-like-windows":  true,
    "late-link-args":  {
                           "gnu":  [
                                       "-lmsvcrt",
                                       "-lmingwex",
                                       "-lmingw32",
                                       "-lgcc",
                                       "-lmsvcrt",
                                       "-lmingwex",
                                       "-luser32",
                                       "-lkernel32"
                                   ],
                           "gnu-cc":  [
                                          "-lmsvcrt",
                                          "-lmingwex",
                                          "-lmingw32",
                                          "-lmsvcrt",
                                          "-lmingwex",
                                          "-luser32",
                                          "-lkernel32"
                                      ],
                           "gnu-lld":  [
                                           "-lmsvcrt",
                                           "-lmingwex",
                                           "-lmingw32",
                                           "-lgcc",
                                           "-lmsvcrt",
                                           "-lmingwex",
                                           "-luser32",
                                           "-lkernel32"
                                       ],
                           "gnu-lld-cc":  [
                                              "-lmsvcrt",
                                              "-lmingwex",
                                              "-lmingw32",
                                              "-lgcc",
                                              "-lmsvcrt",
                                              "-lmingwex",
                                              "-luser32",
                                              "-lkernel32"
                                          ]
                       },
    "late-link-args-dynamic":  {
                                   "gnu":  [
                                               "-lgcc_s"
                                           ],
                                   "gnu-cc":  [

                                              ],
                                   "gnu-lld":  [
                                                   "-lgcc_s"
                                               ],
                                   "gnu-lld-cc":  [
                                                      "-lgcc_s"
                                                  ]
                               },
    "linker":  "x86_64-w64-mingw32-gcc",
    "linker-flavor":  "gnu-cc",
    "llvm-target":  "x86_64-pc-windows-gnu",
    "max-atomic-width":  128,
    "metadata":  {
                     "description":  "64-bit MinGW (Windows 10+)",
                     "host_tools":  true,
                     "std":  true,
                     "tier":  1
                 },
    "os":  "windows",
    "plt-by-default":  false,
    "pre-link-args":  {
                          "gnu":  [
                                      "--dynamicbase",
                                      "--disable-auto-image-base",
                                      "-m",
                                      "i386pep",
                                      "--high-entropy-va"
                                  ],
                          "gnu-cc":  [
                                         "-fno-use-linker-plugin",
                                         "-Wl,--dynamicbase",
                                         "-Wl,--disable-auto-image-base",
                                         "-m64",
                                         "-Wl,--high-entropy-va"
                                     ],
                          "gnu-lld":  [
                                          "--dynamicbase",
                                          "--disable-auto-image-base",
                                          "-m",
                                          "i386pep",
                                          "--high-entropy-va"
                                      ],
                          "gnu-lld-cc":  [
                                             "-fno-use-linker-plugin",
                                             "-Wl,--dynamicbase",
                                             "-Wl,--disable-auto-image-base",
                                             "-m64",
                                             "-Wl,--high-entropy-va"
                                         ]
                      },
    "pre-link-objects-fallback":  {
                                      "dynamic-dylib":  [
                                                            "dllcrt2.o"
                                                        ],
                                      "dynamic-nopic-exe":  [
                                                                "crt2.o"
                                                            ],
                                      "dynamic-pic-exe":  [
                                                              "crt2.o"
                                                          ],
                                      "static-dylib":  [
                                                           "dllcrt2.o"
                                                       ],
                                      "static-nopic-exe":  [
                                                               "crt2.o"
                                                           ],
                                      "static-pic-exe":  [
                                                             "crt2.o"
                                                         ]
                                  },
    "requires-uwtable":  true,
    "target-family":  [
                          "windows"
                      ],
    "target-mcount":  "_mcount",
    "target-pointer-width":  64,
    "vendor":  "pc"
}